#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/esurfingclient

# 等待默认路由就绪
wait_network() {
  local i=0
  while [ $i -lt 60 ]; do
      ip route show default 2>/dev/null | grep -q "default" && return 0
      sleep 1
      i=$((i + 1))
  done
  return 1
}

boot() {
  sleep 5
  start
}

start_service() {
  if ! wait_network; then
      echo "esurfingclient: timeout waiting for network"
      return 1
  fi

  sleep 5

  # 每个可用账号起一个独立的认证进程
  # 这样账号之间完全隔离: 单个账号崩溃或卡住不会波及其它账号,
  # 而且每个实例有各自的崩溃重启计数 (账号级的 respawn 粒度)
  local accounts
  accounts="$($PROG --list-accounts 2>/dev/null)"

  if [ -z "$accounts" ]; then
      echo "esurfingclient: 没有可用账号, 未启动任何实例 (请检查 /var/log/esurfing/logs/run.log)"
      return 0
  fi

  local idx
  local count=0
  local flat=""
  for idx in $accounts; do
      procd_open_instance "account${idx}"
      procd_set_param command $PROG --role auth --account $idx
      procd_set_param respawn 60 5 5
      procd_set_param stdout 1
      procd_set_param stderr 1
      procd_close_instance
      count=$((count + 1))
      flat="${flat}${flat:+ }${idx}"
  done

  echo "esurfingclient: 已启动 ${count} 个认证进程实例: ${flat}"
}

stop_service() {
  :
}

# 改完配置 (增删账号) 后要重新起实例, 所以 reload 必须真的重建
reload_service() {
  stop
  start
}
